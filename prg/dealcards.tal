|0100
  LIT2r ff33
  #17c3 DEI2 INC2 ;random/x STA2
  #c5 DEI2 #c1 DEI2 EOR2 INC2 ;random/y STA2
  DEI ?input
@begin
  DUP2k EOR2 [@ DUPk STZ INC DUP ]?
@loop
  \\ Select random card
  STHrk DUP #04 SFT ORA DUP #02 SFT ORA DUP EQUk SFT ORA
  DUP [@ POP random ADD OVR AND DUP STHrk GTH ]? NIP LDZk
  \\ Display card
  LIT2r =ranks STHk LITr 02 SFTr ADDr LDAr LITr 18 DEOr
  LIT2r =suits STH LITr 03 ANDr ADDr LDAr LITr 18 DEOr
  \\ Exchange card
  LDZrk STH STZr
  \\ Space
  STHrk #0d DIVk MUL NEQ #16 MUL #0a ADD #18 DEO
  \\ Next
  STHrk [? #800f DEO BRK ]@
  ADDrk NIPr !loop

@suits "cdhs
@ranks "A23456789TJQK

@input
  [; #10 DEO2 BRK ]@
  #0417 DEI EQU ?begin
  \\ Try to exchange cards at random due to input
  &re
  #3f3f random AND2
  DUP STHrk GTH ?/re SWP DUP STHrk GTH ?/re
  LDZk ROT LDZk STH SWP STZ STHr STZ
  \\ Change random number seed by input
  #12 DEI ;random/x STA
  BRK

@random ( -- number* )
  ,&x LDR2
  DUP2 #50 SFT2 EOR2
  DUP2 #03 SFT2 EOR2
  ,&y LDR2 DUP2 ,&x STR2
  DUP2 #01 SFT2 EOR2 EOR2
  ,&y STR2k POP
  JMP2r
  &x $2 &y $2
